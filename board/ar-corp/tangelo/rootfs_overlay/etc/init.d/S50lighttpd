#!/bin/sh
#
# Starts lighttpd.
#
NAME=lighttpd
DAEMON=/usr/sbin/$NAME
PID_FILE="/var/run/$NAME.pid"
CONF_FILE="/etc/$NAME/$NAME.conf"

[ -r /etc/default/$NAME ] && . /etc/default/$NAME

# lighttpd now logs errors to syslogd and the access log is disabled (see
# conf-enabled/syslog.conf and conf.d/access_log.conf). Older images wrote
# both to files on the persistent /var/log (mmcblk0p4) with no rotation,
# and the access log can fill the partition, so remove any leftovers.
remove_old_logs() {
	rm -f /var/log/lighttpd-error.log /var/log/lighttpd-access.log
}

# HTTPS key and certificate: arsystem makes a self-signed pair if there is
# none (see etc/lighttpd/conf-enabled/tls.conf). Its failure leaves HTTP only.
make_tls_cert() {
	/usr/sbin/arsystem --tls-init >/dev/null 2>&1 || logger -t lighttpd "no TLS certificate; HTTPS off"
}

start() {
	remove_old_logs
	make_tls_cert
	# include_shell returns to the start directory on every graceful restart,
	# as www-data; a shell left in /root would make that fail and stop lighttpd.
	cd /
	printf "Starting lighttpd: "
	start-stop-daemon -S -q -p $PID_FILE --exec $DAEMON -- -f $CONF_FILE
	echo "OK"
}
stop() {
	printf "Stopping lighttpd: "
	start-stop-daemon -K -q -p $PID_FILE
	echo "OK"
}
restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
