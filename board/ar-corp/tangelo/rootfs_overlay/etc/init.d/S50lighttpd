#!/bin/sh
#
# Starts lighttpd.
#
NAME=lighttpd
DAEMON=/usr/sbin/$NAME
PID_FILE="/var/run/$NAME.pid"
CONF_FILE="/etc/$NAME/$NAME.conf"

[ -r /etc/default/$NAME ] && . /etc/default/$NAME

# /var/log now persists on mmcblk0p4 (root:root 755) instead of the old
# world-writable tmpfs, so lighttpd (running as www-data) can no longer
# create its own log files there. Pre-create/own them per the ownership
# already declared in package/lighttpd/lighttpd_tmpfiles.conf -- that
# file is a systemd-tmpfiles.d spec that never runs under busybox init.
precreate_logs() {
	for f in lighttpd-error.log lighttpd-access.log; do
		[ -e "/var/log/$f" ] || touch "/var/log/$f"
		chown www-data:www-data "/var/log/$f"
		chmod 0640 "/var/log/$f"
	done
}

start() {
	precreate_logs
	printf "Starting lighttpd: "
	start-stop-daemon -S -q -p $PID_FILE --exec $DAEMON -- -f $CONF_FILE
	echo "OK"
}
stop() {
	printf "Stopping lighttpd: "
	start-stop-daemon -K -q -p $PID_FILE
	echo "OK"
}
restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
