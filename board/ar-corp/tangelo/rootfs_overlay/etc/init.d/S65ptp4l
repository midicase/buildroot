#!/bin/sh
#
# Start linuxptp
#
# Overrides the linuxptp package's script. The stock one starts unconditionally,
# which would put phc2sys and chronyd on the same clock; gate it on the time
# mechanism arsystem persists instead.
#

DAEMON="ptp4l"

PIDFILE="/var/run/$DAEMON.pid"

PTP4L_ARGS="-f /etc/linuxptp.cfg"

MECHFILE="/var/lib/arsystem/time_mechanism"

# shellcheck source=/dev/null
[ -r "/etc/default/ptp4l" ] && . "/etc/default/ptp4l"

selected() {
	[ -r "$MECHFILE" ] && [ "$(cat "$MECHFILE")" = "ptp" ]
}

start() {
	if ! selected; then
		echo "PTP is not the selected time mechanism, not starting $DAEMON"
		return 0
	fi
	printf "Starting linuxptp daemon: "
	start-stop-daemon -S -b -q -m -p $PIDFILE \
		-x /usr/sbin/$DAEMON -- $PTP4L_ARGS
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return $status
}

stop() {
	[ -f "$PIDFILE" ] || return 0
	printf "Stopping linuxptp daemon: "
	start-stop-daemon -K -q -p $PIDFILE
	status=$?
	if [ "$status" -eq 0 ]; then
		rm -f "$PIDFILE"
		echo "OK"
	else
		echo "FAIL"
	fi
	return $status
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	stop
	start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
