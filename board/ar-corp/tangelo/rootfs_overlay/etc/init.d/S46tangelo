#!/bin/sh

DAEMON="tangelo"
PIDFILE="/var/run/$DAEMON.pid"
export TANGELO_USE_FS=true
export TANGELO_SKIP_AUTH=true
export TANGELO_CFG=/var/lib/tangelo/tangelo.cfg

if [ -f /etc/env.conf ]; then
    source /etc/env.conf
fi

# Hold the eth0 IRQ on CPU0. tangelo's DMA worker pins itself to the highest
# core (dma.cpp, pin_worker_off_irq_cpu) so the two never share: colliding them
# costs 27% of the small-packet drain rate. Best effort -- never blocks start.
pin_eth_irq() {
	[ "$(nproc 2>/dev/null || echo 1)" -gt 1 ] || return 0
	irq=$(awk -F: '/eth0/ {gsub(/ /,"",$1); print $1; exit}' /proc/interrupts)
	[ -n "$irq" ] && [ -w "/proc/irq/$irq/smp_affinity" ] || return 0
	echo 1 > "/proc/irq/$irq/smp_affinity" 2>/dev/null
}

start() {
	printf 'Starting %s: ' "$DAEMON"
	pin_eth_irq
	# auto core dump
	ulimit -c unlimited
	start-stop-daemon -S -b -q -m -p "$PIDFILE" --exec "/usr/sbin/$DAEMON" 
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}
stop() {
printf 'Stopping %s: ' "$DAEMON"
	start-stop-daemon -K -q -p "$PIDFILE"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	while start-stop-daemon -K -t -q -p "$PIDFILE" --exec "/usr/sbin/$DAEMON"; do
		sleep 0.1
	done
	rm -f "$PIDFILE"
	return "$status"
}
restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?

